{
  "name": "Require two approvals for simaai-linux",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "repository_name": {
      "include": ["simaai-linux"],
      "exclude": [],
      "protected": false
    },
    "ref_name": {
      "include": ["refs/heads/main", "refs/heads/develop", "refs/heads/release-*", "refs/heads/v[0-9]*.[0-9]*.[0-9]*"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["merge", "squash", "rebase"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "require_extra_approval_for_unattributed_changes": true,
        "required_approving_review_count": 2,
        "required_review_thread_resolution": true
      }
    }
  ]
}
